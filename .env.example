# Copy this file to .env and fill in your keys. .env is gitignored — never commit real keys.

# Required for receipt photo scanning (OCR) and last-resort carbon estimates.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: second-tier item matching via Climatiq.
CLIMATIQ_API_KEY=

# Frontend demo mode. Switch to live to call the local FastAPI backend.
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000
# Where saved trip history lives: "local" (default) keeps it in each
# visitor's browser; "backend" stores it in the API's database instead
# (note: on ephemeral hosting like Render's free tier, backend history
# is wiped on every redeploy).
VITE_HISTORY_STORAGE=local
# Optional: pins the Climatiq data version used for search/estimate calls.
# Defaults to ^33 if unset.
CLIMATIQ_DATA_VERSION=

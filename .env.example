# Copy this file to .env and fill in your keys. .env is gitignored — never commit real keys.

# Required for receipt photo scanning (OCR) and last-resort carbon estimates.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: second-tier item matching via Climatiq.
CLIMATIQ_API_KEY=

# Optional: pins the Climatiq data version used for search/estimate calls.
# Defaults to ^33 if unset.
CLIMATIQ_DATA_VERSION=
